{
  "name": "brand-industry/craft-editrix",
  "description": "Search and replace content across entries, globals, Matrix and Neo, with a preview before anything changes, a log of every change and a revert for each value.",
  "version": "2.0.0",
  "type": "craft-plugin",
  "license": "proprietary",
  "keywords": [
    "craftcms",
    "craft",
    "search",
    "replace",
    "find",
    "content",
    "bulk",
    "editrix"
  ],
  "authors": [
    {
      "name": "Brand Industry",
      "email": "lalonso@tbi.com.mx",
      "homepage": "https://thebrandindustry.com/"
    },
    {
      "name": "Lucas A Alonso Cruz",
      "email": "lalonso.dev@gmail.com",
      "homepage": "https://useralberto.github.io/"
    }
  ],
  "support": {
    "email": "lalonso@tbi.com.mx",
    "docs": "https://github.com/brand-industry/craft-editrix/tree/craft-5"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "brandindustry\\editrix\\": "plugin/src/"
    }
  },
  "extra": {
    "name": "Editrix",
    "handle": "editrix",
    "hasCpSettings": true,
    "hasCpSection": true,
    "class": "brandindustry\\editrix\\Editrix",
    "developer": "Brand Industry",
    "developerUrl": "https://tbi.com.mx",
    "documentationUrl": "https://github.com/brand-industry/craft-editrix/tree/craft-5",
    "changelogUrl": "https://github.com/brand-industry/craft-editrix/blob/craft-5/CHANGELOG.md"
  }
}

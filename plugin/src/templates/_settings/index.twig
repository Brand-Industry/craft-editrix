{% extends "editrix/_layouts/base" %}
{% import "_includes/forms" as forms %}

{% set title = "Editrix - Settings"|t('editrix') %}
{% set selectedSubnavItem = 'settings' %}

{% block pluginContent %}

<form method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('editrix/settings/save') }}
    {{ redirectInput('editrix/settings') }}

    <h2>{{ "Edition"|t('editrix') }}</h2>

    <p class="light">
        {{ "Current edition:"|t('editrix') }} <strong>{{ edition|capitalize }}</strong>
        {% if edition == 'standard' %}
            — <a href="https://plugins.craftcms.com/editrix" target="_blank">{{ "Upgrade"|t('editrix') }}</a>
        {% endif %}
    </p>

    <hr>

    <h2>{{ "Search Defaults"|t('editrix') }}</h2>

    {{ forms.checkboxField({
        label: "Search in Entries"|t('editrix'),
        id: 'searchEntries',
        name: 'searchEntries',
        checked: settings.searchEntries,
    }) }}

    {{ forms.checkboxField({
        label: "Search in Globals"|t('editrix'),
        id: 'searchGlobals',
        name: 'searchGlobals',
        checked: settings.searchGlobals,
    }) }}

    {{ forms.checkboxField({
        label: "Search in Matrix fields"|t('editrix'),
        instructions: "Requires Standard or Pro edition"|t('editrix'),
        id: 'searchMatrix',
        name: 'searchMatrix',
        checked: settings.searchMatrix,
    }) }}

    {{ forms.checkboxField({
        label: "Search in Categories"|t('editrix'),
        instructions: "Requires Standard or Pro edition"|t('editrix'),
        id: 'searchCategories',
        name: 'searchCategories',
        checked: settings.searchCategories,
    }) }}

    <hr>

    <h2>{{ "Logs"|t('editrix') }}</h2>

    {{ forms.textField({
        label: "Log Retention (days)"|t('editrix'),
        instructions: "How long to keep operation logs. Limited by your edition (Standard: 30, Pro: 90)."|t('editrix'),
        id: 'logRetentionDays',
        name: 'logRetentionDays',
        value: settings.logRetentionDays,
        type: 'number',
        min: 1,
        max: 365,
        size: 5,
    }) }}

    <hr>

    <h2>{{ "Safety"|t('editrix') }}</h2>

    {{ forms.textField({
        label: "Bulk Confirmation Threshold"|t('editrix'),
        instructions: "Require extra confirmation when replacing more than this many entries."|t('editrix'),
        id: 'bulkConfirmationThreshold',
        name: 'bulkConfirmationThreshold',
        value: settings.bulkConfirmationThreshold,
        type: 'number',
        min: 1,
        size: 5,
    }) }}

    {{ forms.checkboxField({
        label: "Show Environment Indicator"|t('editrix'),
        instructions: "Display current environment (production/staging/dev) in the UI."|t('editrix'),
        id: 'showEnvironmentIndicator',
        name: 'showEnvironmentIndicator',
        checked: settings.showEnvironmentIndicator,
    }) }}

    {{ forms.checkboxField({
        label: "Production Safe Mode"|t('editrix'),
        instructions: "Require confirmation code before replacing in production environment."|t('editrix'),
        id: 'productionSafeMode',
        name: 'productionSafeMode',
        checked: settings.productionSafeMode,
        disabled: edition != 'pro',
    }) }}

    <hr>

    <button type="submit" class="btn submit">{{ "Save"|t('app') }}</button>
</form>

{% endblock %}
